<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="zed2i_gazebo_sensor" params="parent_link">
        <gazebo reference="${parent_link}">
            <sensor name="zed2i_camera" type="rgbd_camera">
                <camera>
                    <horizontal_fov>1.91986</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.3</near>
                        <far>20.0</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>zed2i/camera</topic>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>